# ============================================================================
# JARVIS frontend — environment variables
# ============================================================================
# Copy this file to `.env.local` (Vite's default local-override file — already
# gitignored by frontend/.gitignore). Then fill in the real values.
#
#   cp frontend/.env.example frontend/.env.local
#
# NEVER put the Supabase service_role key here — that belongs in backend/.env.
# Anything prefixed with VITE_ is bundled into the browser JS and public.

# Supabase Project URL — same as backend's SUPABASE_URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase `anon` public key — safe to ship to the browser
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...REPLACE_ME

# Leave empty to use the Vite dev proxy (`/api/*` -> http://127.0.0.1:8000).
# Only set this if you're deploying the frontend separately from the backend.
VITE_BACKEND_URL=
