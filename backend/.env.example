# ============================================================================
# JARVIS backend — environment variables
# ============================================================================
# Copy this file to `.env` (same directory as this file, or at the repo root)
# and fill in the real values. Never commit `.env` — it's gitignored.
#
# The backend calls `load_dotenv()` at startup, resolving from:
#   1. /Users/.../jarvis-recovered/.env           (repo root — recommended)
#   2. /Users/.../jarvis-recovered/backend/.env   (also supported)
#
# Using the repo-root .env lets you share it with the frontend if you need.

# ----------------------------------------------------------------------------
# Anthropic (Claude) — used by /api/chat and the Claude Vision OCR path
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
# Optional override — defaults to claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional vision model override — defaults to the same as ANTHROPIC_MODEL
# ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# ----------------------------------------------------------------------------
# OpenAI — used by /api/voice (Whisper STT) and /api/realtime (Realtime WebRTC)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-REPLACE_ME
# Optional overrides — defaults shown
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=sage
# OPENAI_REALTIME_INSTRUCTIONS=You are JARVIS...

# ----------------------------------------------------------------------------
# Supabase — one project, three keys
#
# Dashboard → Project Settings → API:
#   Project URL              -> SUPABASE_URL
#   `anon` public key        -> SUPABASE_ANON_KEY       (safe for frontend)
#   `service_role` secret    -> SUPABASE_SERVICE_ROLE_KEY (BACKEND ONLY)
#
# The service role key bypasses RLS. Never ship it to a browser.
# ----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...REPLACE_ME_SERVICE_ROLE

# ----------------------------------------------------------------------------
# Optional — ElevenLabs text-to-speech. Only needed if you enable the
# ElevenLabs voice path (the default voice flow uses OpenAI Realtime).
# ----------------------------------------------------------------------------
# ELEVENLABS_API_KEY=
